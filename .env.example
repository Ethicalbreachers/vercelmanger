# Vercel
VERCEL_TOKEN=your_vercel_personal_access_token
VERCEL_TEAM_ID=

# GitHub OAuth App (https://github.com/settings/developers → New OAuth App)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=https://your-app.onrender.com/auth/github/callback

# Basic Auth (protect the dashboard)
BASIC_USER=admin
BASIC_PASS=changeme123

# Session secret (koi random string)
SESSION_SECRET=some-long-random-string-here

PORT=3000
NODE_ENV=production